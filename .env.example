# PoliBrief V1 — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
# Set a stable, private value of at least 32 characters before starting PoliBrief.
SECRET_KEY=
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./storage/database/polibrief.db

# ─── Session ───────────────────────────────────────────────────────────────────
SESSION_EXPIRE_HOURS=8
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── News Collection ───────────────────────────────────────────────────────────
COLLECTION_INTERVAL_MINUTES=30
NEWS_RETENTION_DAYS=30
FINGERPRINT_RETENTION_DAYS=90
PUBLICATION_HISTORY_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30

# ─── Meta / Facebook (optional) ────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage
GENERATED_IMAGES_PATH=./storage/generated
TEMPLATES_PATH=./storage/templates
LOGS_PATH=./storage/logs
